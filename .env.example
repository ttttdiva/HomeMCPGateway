# Copy to .env and fill in the existing tunnel's runtime credentials.
CONTROL_PLANE_TUNNEL_ID=tunnel_replace_me
CONTROL_PLANE_API_KEY=replace_me
TUNNEL_ALIAS=home-mcp
# Optional absolute path. Otherwise the bundled executable or PATH is used.
# TUNNEL_CLIENT_PATH=C:\Tools\tunnel-client.exe

# Optional TypeSafe/Jev target selection for browser_run_plan.
# Resolution order is process environment, then this Gateway's own .env.
# Keep this local; never pass the key through MCP arguments or Codex config.
# JEV_API_KEY=replace_me

# Optional AoiTalk integration. Disabled unless explicitly enabled below.
# HOME_MCP_AOITALK_ENABLED=true
# Credentials are read locally from its .env; never put them in ChatGPT.
# HOME_MCP_AOITALK_URL=http://127.0.0.1:3000
# HOME_MCP_AOITALK_ENV_FILE=C:\path\to\AoiTalk\.env
# Optional existing, accessible Docs destination UUID:
# HOME_MCP_AOITALK_TARGET_NODE_ID=

# Optional Infinite Image Browsing chat-context integration.
# HOME_MCP_IMAGE_LIBRARY_ROOT=C:\path\to\Infinite-Image-Browsing
# HOME_MCP_IMAGE_LIBRARY_DB=C:\path\to\Infinite-Image-Browsing\iib.db
# Semicolon-separated folders used only when image_path is omitted.
# HOME_MCP_IMAGE_LIBRARY_DOWNLOAD_DIRS=C:\Users\example\Downloads
